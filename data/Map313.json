1,"parameters":["about to do. Got it?"]},{"code":101,"indent":1,"parameters":["A_elim",4,0,2,"Elim"]},{"code":401,"indent":1,"parameters":["Got it...here goes nothing."]},{"code":242,"indent":1,"parameters":[1]},{"code":126,"indent":1,"parameters":[208,1,0,1]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["The bottle smashes on the ground...."]},{"code":250,"indent":1,"parameters":[{"name":"Foam3_mvt","volume":90,"pitch":100,"pan":0}]},{"code":101,"indent":1,"parameters":["A_tali",1,0,2,"Tali"]},{"code":401,"indent":1,"parameters":["There's smoke coming from the bottle..."]},{"code":250,"indent":1,"parameters":[{"name":"Wind9","volume":90,"pitch":100,"pan":0}]},{"code":224,"indent":1,"parameters":[[255,255,255,255],180,true]},{"code":221,"indent":1,"parameters":[]},{"code":203,"indent":1,"parameters":[25,0,9,7,4]},{"code":201,"indent":1,"parameters":[0,318,7,18,2,0]},{"code":211,"indent":1,"parameters":[1]},{"code":222,"indent":1,"parameters":[]},{"code":101,"indent":1,"parameters":["A_elim",4,0,2,"Elim"]},{"code":401,"indent":1,"parameters":["It worked!"]},{"code":101,"indent":1,"parameters":["F-chara Dragon-knight",0,0,2,"Vaeraxis"]},{"code":401,"indent":1,"parameters":["Where have we wound up though?"]},{"code":101,"indent":1,"parameters":["A_Feylora",0,0,2,"Feylora"]},{"code":401,"indent":1,"parameters":["Lets go find out."]},{"code":221,"indent":1,"parameters":[]},{"code":121,"indent":1,"parameters":[398,398,1]},{"code":205,"indent":1,"parameters":[-1,{"list":[{"code":19,"indent":null},{"code":0}],"repeat":false,"skippable":false,"wait":true}]},{"code":505,"indent":1,"parameters":[{"code":19,"indent":null}]},{"code":222,"indent":1,"parameters":[]},{"code":101,"indent":1,"parameters":["",0,0,2,""]},{"code":401,"indent":1,"parameters":["Your Journal has been updated."]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"We need more time."]},{"code":101,"indent":1,"parameters":["SF_Actor3",5,0,2