{"id":25,"name":"Moni","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"SF_Actor3","direction":2,"pattern":1,"characterIndex":5},"list":[{"code":101,"indent":0,"parameters":["SF_Actor3",5,0,2,"Resident"]},{"code":401,"indent":0,"parameters":["Welcome to the city - Gears align!"]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":208,"itemValid":true,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":397,"switch1Valid":true,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"SF_Actor3","direction":2,"pattern":1,"characterIndex":5},"list":[{"code":101,"indent":0,"parameters":["A_elim",4,0,2,"Elim"]},{"code":401,"indent":0,"parameters":["Gears Align - would you happen to be Moni?"]},{"code":101,"indent":0,"parameters":["SF_Actor3",5,0,2,"Moni"]},{"code":401,"indent":0,"parameters":["They turn true, stanger! And yes, I am Moni."]},{"code":401,"indent":0,"parameters":["Is there something that I can assist you with"]},{"code":401,"indent":0,"parameters":["today?"]},{"code":101,"indent":0,"parameters":["A_tali",0,0,2,"Tali"]},{"code":401,"indent":0,"parameters":["Hello! We acquired this portal potion, and"]},{"code":401,"indent":0,"parameters":["we took it to the Alchemist's Guild here in"]},{"code":401,"indent":0,"parameters":["the city. We were told that you could possibly"]},{"code":401,"indent":0,"parameters":["help us use it?"]},{"code":101,"indent":0,"parameters":["SF_Actor3",5,0,2,"Moni"]},{"code":401,"indent":0,"parameters":["Ahhh yes! A portal potion! I haven't seen one"]},{"code":401,"indent":0,"parameters":["of these for quite some time! Yes I think I"]},{"code":401,"indent":0,"parameters":["can help you with this. Let me see this for"]},{"code":401,"indent":0,"parameters":["just a moment."]},{"code":101,"indent":0,"parameters":["",0,0,2,""]},{"code":401,"indent":0,"parameters":["She produces a small magnifying glass from her belt, and"]},{"code":401,"indent":0,"parameters":["holds it up to the potion, examining it carefully. She"]},{"code":401,"indent":0,"parameters":["swirls it around a bit, before handing it back to you."]},{"code":101,"indent":0,"parameters":["SF_Actor3",5,0,2,"Moni"]},{"code":401,"indent":0,"parameters":["Portal potions are basically pocket dimensions."]},{"code":401,"indent":0,"parameters":["There's no telling how big each one is."]},{"code":401,"indent":0,"parameters":["Typically you're taking about the size of a"]},{"code":401,"indent":0,"parameters":["small castle from my past experience though."]},{"code":101,"indent":0,"parameters":["A_elim",4,0,2,"Elim"]},{"code":401,"indent":0,"parameters":["So how does this work, do you need to shrink"]},{"code":401,"indent":0,"parameters":["us?"]},{"code":101,"indent":0,"parameters":["SF_Actor3",5,0,2,"Moni"]},{"code":401,"indent":0,"parameters":["Essentially yes - although you'll be unaware"]},{"code":401,"indent":0,"parameters":["of the process. Everything in these pockets"]},{"code":401,"indent":0,"parameters":["will be life sized when you get there."]},{"code":101,"indent":0,"parameters":["A_alex",1,0,2,"Alex"]},{"code":401,"indent":0,"parameters":["May I ask, how we are to return from the"]},{"code":401,"indent":0,"parameters":["pocket dimension?"]},{"code":101,"indent":0,"parameters":["SF_Actor3",5,0,2,"Moni"]},{"code":401,"indent":0,"parameters":["A good question! Each of these pocket"]},{"code":401,"indent":0,"parameters":["dimensions will have a Portal Potion inside"]},{"code":401,"indent":0,"parameters":["them. In fact, its part of the spell to create"]},{"code":401,"indent":0,"parameters":["one. If the potion had been destroyed for"]},{"code":101,"indent":0,"parameters":["SF_Actor3",5,0,2,"Moni"]},{"code":401,"indent":0,"parameters":["example, then this one i'm holding right here"]},{"code":401,"indent":0,"parameters":["would simply cease to exist. This is proof that"]},{"code":401,"indent":0,"parameters":["the return potion is still inside."]},{"code":101,"indent":0,"parameters":["F-chara Dragon-knight",0,0,2,"Vaeraxis"]},{"code":401,"indent":0,"parameters":["And what is the purpose of this? Are we really"]},{"code":401,"indent":0,"parameters":["likely to find anything of value?"]},{"code":101,"indent":0,"parameters":["SF_Actor3",5,0,2,"Moni"]},{"code":401,"indent":0,"parameters":["I've raided a couple of these in my time, and"]},{"code":401,"indent":0,"parameters":["I must say that generally it is worth the"]},{"code":401,"indent":0,"parameters":["trouble. However, that's not to say that its"]},{"code":401,"indent":0,"parameters":["particularly safe either. You should expect"]},{"code":101,"indent":0,"parameters":["SF_Actor3",5,0,2,"Moni"]},{"code":401,"indent":0,"parameters":["danger, combat and more."]},{"code":101,"indent":0,"parameters":["A_Feylora",0,0,2,"Feylora"]},{"code":401,"indent":0,"parameters":["What about anything we find? Won't it be small"]},{"code":401,"indent":0,"parameters":["and unusable?"]},{"code":101,"indent":0,"parameters":["SF_Actor3",5,0,2,"Moni"]},{"code":401,"indent":0,"parameters":["Anything you find will be returned to full"]},{"code":401,"indent":0,"parameters":["size, along with your bodies."]},{"code":101,"indent":0,"parameters":["A_elim",4,0,2,"Elim"]},{"code":401,"indent":0,"parameters":["Ok, we will prepare, and then return."]},{"code":123,"indent":0,"parameters":["A",0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"lis